// All coefficient degenerations inside the a!=0 branch are retained.
ring r=13,(w,v,u),dp;
option(redSB);
poly a=4;
poly b=-9*u4-3*u;
poly c=-8*v18-11*v15-3*b*v14;
poly d=-1-a-b-c;
proc f(poly x){return(x^20+a*x^17+b*x^16+c*x^2+d*x);}
ideal I=f(u),f(v),f(w),7*w19+3*w16+3*b*w15+2*c*w+d;
int begin=timer;
ideal G=std(I);
print("SECONDS");print(timer-begin);
print("DIMENSION");print(dim(G));
print("VDIM");print(vdim(G));
print("BASIS_SIZE");print(size(G));
print("BASIS");G;
quit;
