ring r=0,(x,e),dp;
poly A=-1140;
poly B=14535;
poly C=-1589350-45*e;
poly D=1575954+44*e;
poly Q=x19+A*x16+B*x15+e*x9+C*x+D;
poly H10=184756*x10+19448*A*x7+8008*B*x6+e;
poly H1=20*x19+17*A*x16+16*B*x15+10*e*x9+2*C*x+D;
int begin=timer;
poly R10=resultant(Q,H10,x);
print("R10_SECONDS");print(timer-begin);
print("R10_DEGREE");print(deg(R10));
poly R1=resultant(Q,H1,x);
print("BOTH_SECONDS");print(timer-begin);
print("R1_DEGREE");print(deg(R1));
poly G=gcd(R10,R1);
print("GCD");G;
print("R10");R10;
print("R1");R1;
quit;
