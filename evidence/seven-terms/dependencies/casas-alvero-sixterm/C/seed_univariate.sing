ring r=13,(x,u),lp;
short=0;
poly b=5*u^5+u;
poly q=u+1;
poly N=5+b-6*u^19-5*u^15;
poly cn=N/(u-1);
if(cn*(u-1)!=N){ERROR("Nonexact cancellation");}
poly dn=q*(8-b)-cn;
poly P=q*(x^19+4*x^15+b*x^14)+cn*x^2+dn;
poly H3=q*(9*x^17+4*x^13)+cn;
poly H1=q*(7*x^19+12*x^15+2*b*x^14)+3*cn*x^2+dn;
poly R3=resultant(P,H3,x);
poly R1=resultant(P,H1,x);
poly G=gcd(cn*R3,dn*R1);
print("GENERIC_R3");print(R3);
print("GENERIC_R1");print(R1);
print("GENERIC_GCD");print(G);
print("GENERIC_FACTORS");factorize(G);
poly Pc=x^19+4*x^15+6*x^14+u*x^2+2-u;
poly Dc3=9*x^17+4*x^13+u;
poly Dc1=7*x^19+12*x^15+12*x^14+3*u*x^2+2-u;
poly Rc3=resultant(Pc,Dc3,x);
poly Rc1=resultant(Pc,Dc1,x);
poly Gc=gcd(u*Rc3,(2-u)*Rc1);
print("SPECIAL_R3");print(Rc3);
print("SPECIAL_R1");print(Rc1);
print("SPECIAL_GCD");print(Gc);
print("SPECIAL_FACTORS");factorize(Gc);
quit;
